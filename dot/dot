#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=dot/lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=dot/lib/symlink.sh
source "$SCRIPT_DIR/lib/symlink.sh"

usage() {
  cat <<USAGE
Usage:
  dot/dot setup [--dry-run] [--overwrite|--skip-existing|--interactive] [--verbose]
  dot/dot backup [--dry-run] [--verbose]
  dot/dot restore [--dry-run] [--apply] [--verbose]
USAGE
}

parse_common_flags() {
  CONFLICT_POLICY="skip-existing"
  APPLY=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        DRY_RUN=1
        ;;
      --apply)
        APPLY=1
        ;;
      --overwrite)
        CONFLICT_POLICY="overwrite"
        ;;
      --skip-existing)
        CONFLICT_POLICY="skip-existing"
        ;;
      --interactive)
        CONFLICT_POLICY="interactive"
        ;;
      --verbose)
        VERBOSE=1
        ;;
      *)
        die "Unknown option: $1"
        ;;
    esac
    shift
  done
}

run_manifest() {
  local manifest="$1"
  local mode="$2"
  local repo_root="$3"

  if [[ ! -f "$manifest" ]]; then
    error "Missing manifest: $manifest"
    return 1
  fi

  local snapshot_root=""
  if [[ "$mode" == "restore" ]]; then
    if [[ "$APPLY" != "1" ]]; then
      DRY_RUN=1
      info "Restore defaults to dry-run. Use --apply to perform writes."
    fi
    snapshot_root="$HOME/.dotfiles-restore-backups/$(date +%Y%m%d-%H%M%S)"
  fi

  MANIFEST_SKIPPED=0
  local action src_raw dst_raw src dst
  while IFS=$'\t' read -r action src_raw dst_raw; do
    [[ -n "$action" ]] || continue
    [[ "$action" =~ ^# ]] && continue

    src="$(resolve_vars "$src_raw" "$repo_root")"
    dst="$(resolve_vars "$dst_raw" "$repo_root")"

    case "$action" in
      symlink)
        [[ -e "$src" || -L "$src" ]] || { warn "Missing source, skip: $src"; ((MANIFEST_SKIPPED += 1)); continue; }
        ensure_symlink "$src" "$dst" "$CONFLICT_POLICY" || return
        ;;
      copy)
        [[ -e "$src" || -L "$src" ]] || { warn "Missing source, skip: $src"; ((MANIFEST_SKIPPED += 1)); continue; }
        if [[ "$mode" == "setup" ]] && ! should_replace_target "$dst" "$CONFLICT_POLICY"; then
          continue
        fi
        if [[ "$mode" == "restore" ]]; then
          snapshot_path_if_exists "$dst" "$snapshot_root"
        fi
        copy_path "$src" "$dst" || return
        ;;
      sync_dir)
        [[ -d "$src" ]] || { warn "Missing source dir, skip: $src"; ((MANIFEST_SKIPPED += 1)); continue; }
        if [[ "$mode" == "restore" ]]; then
          snapshot_path_if_exists "$dst" "$snapshot_root"
        fi
        ensure_dir "$dst" || return
        run_cmd rsync -a "$src" "$dst" || return
        ;;
      sync_glob)
        shopt -s nullglob
        local matches=( $src )
        shopt -u nullglob
        if [[ ${#matches[@]} -eq 0 ]]; then
          warn "No sources matched, skip: $src"
          ((MANIFEST_SKIPPED += 1))
          continue
        fi
        ensure_dir "$dst" || return
        if [[ "$mode" == "restore" ]]; then
          snapshot_path_if_exists "$dst" "$snapshot_root"
        fi
        run_cmd rsync -a "${matches[@]}" "$dst" || return
        ;;
      *)
        error "Unknown action in manifest: $action"
        return 1
        ;;
    esac
  done < "$manifest"

  if [[ "$mode" == "restore" ]]; then
    info "Rollback snapshot directory: $snapshot_root"
  fi
}

manifest_status() {
  if [[ "$MANIFEST_SKIPPED" -gt 0 ]]; then
    printf 'partial\n'
  else
    printf 'ok\n'
  fi
}

backup_dotfiles() {
  local repo_root="$1"

  if ! command_exists brew; then
    error "Required command not found: brew"
    return 1
  fi

  run_cmd brew bundle dump --force --file="$repo_root/scripts/Brewfile" --describe || return
  run_manifest "$repo_root/dot/manifests/backup.macos.tsv" "backup" "$repo_root"
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 1; }

  local command="$1"
  shift
  parse_common_flags "$@"

  local repo_root
  repo_root="$(require_repo_root)"

  case "$command" in
    setup)
      is_macos || die "dot setup currently supports macOS only"
      run_manifest "$repo_root/dot/manifests/setup.macos.tsv" "setup" "$repo_root"
      ensure_private_file "$HOME/.localrc"
      ensure_private_file "$HOME/.localenv"
      local setup_status
      setup_status="$(manifest_status)"
      write_run_log "$repo_root" "dot setup" "$setup_status" "manifest=setup.macos.tsv,skipped=$MANIFEST_SKIPPED"
      ;;
    backup)
      is_macos || die "dot backup currently supports macOS only"
      if backup_dotfiles "$repo_root"; then
        local backup_status
        backup_status="$(manifest_status)"
        if [[ "$MANIFEST_SKIPPED" -gt 0 ]]; then
          warn "Backup completed with $MANIFEST_SKIPPED skipped source(s)."
        fi
        write_run_log "$repo_root" "dot backup" "$backup_status" "manifest=backup.macos.tsv,skipped=$MANIFEST_SKIPPED"
      else
        local backup_exit=$?
        write_run_log "$repo_root" "dot backup" "failed" "manifest=backup.macos.tsv,exit=$backup_exit" || true
        return "$backup_exit"
      fi
      ;;
    restore)
      is_macos || die "dot restore currently supports macOS only"
      run_manifest "$repo_root/dot/manifests/restore.macos.tsv" "restore" "$repo_root"
      local restore_status
      restore_status="$(manifest_status)"
      write_run_log "$repo_root" "dot restore" "$restore_status" "manifest=restore.macos.tsv,apply=$APPLY,skipped=$MANIFEST_SKIPPED"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
